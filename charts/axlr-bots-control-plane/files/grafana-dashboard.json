    "query": "prometheus",
    "current": {},
    "hide": 0
   },
   {
    "name": "loki",
    "label": "Loki",
    "type": "datasource",
    "query": "loki",
    "current": {},
    "hide": 0
   },
   {
    "name": "namespace",
    "label": "Namespace",
    "type": "custom",
    "query": "axlr-bots",
    "current": {
     "text": "axlr-bots",
     "value": "axlr-bots"
    },
    "hide": 0
   },
   {
    "name": "container",
    "label": "Contenedor",
    "type": "custom",
    "query": "control-plane,github-hooks,activity-audit",
    "multi": true,
    "includeAll": true,
    "allValue": ".+",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "hide": 0
   },
   {
    "name": "component",
    "label": "Componente",
    "type": "custom",
    "query": "daemon,nats,filestore,github-hooks,activity-audit",
    "multi": true,
    "includeAll": true,
    "allValue": ".*",
    "current": {
     "text": "All",
     "value": "$__all"
    },
    "hide": 0
   },
