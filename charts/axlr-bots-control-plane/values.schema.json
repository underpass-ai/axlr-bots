{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {"type": "object", "required": ["repository"], "properties": {
      "repository": {"type": "string", "minLength": 1},
      "tag": {"type": "string", "pattern": "^([0-9A-Za-z._-]{1,128})?$"},
      "digest": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$"},
      "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}}},
    "imagePullSecrets": {"type": "array"},
    "serverNames": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "apiURL": {"type": "string"},
    "minAXLRVersion": {"type": "string", "pattern": "^([0-9]+\\.[0-9]+\\.[0-9]+)?$"},
    "env": {"type": "object", "properties": {
      "existingSecret": {"type": "string"},
      "extra": {"type": "array"}}},
    "apiToken": {"type": "object", "properties": {
      "existingSecret": {"type": "string"},
      "key": {"type": "string", "minLength": 1}}},
    "bus": {"type": "object", "properties": {
      "kind": {"enum": ["direct", "nats"]},
      "nats": {"type": "object", "properties": {
        "url": {"type": "string"},
        "existingSecret": {"type": "string"}}}}},
    "ca": {"type": "object", "properties": {"init": {"type": "boolean"}}},
    "persistence": {"type": "object", "properties": {
      "existingClaim": {"type": "string"},
      "size": {"type": "string", "minLength": 1},
      "storageClassName": {"type": "string"},
      "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
      "keep": {"type": "boolean"}}},
    "service": {"type": "object", "properties": {
      "type": {"enum": ["ClusterIP", "LoadBalancer", "NodePort"]},
      "annotations": {"type": "object"},
      "externalTrafficPolicy": {"enum": ["Cluster", "Local"]},
      "nodePort": {"type": "integer", "minimum": 1, "maximum": 65535},
      "apiPort": {"type": "integer", "minimum": 1, "maximum": 65535},
      "extraPorts": {"type": "array", "items": {"type": "object", "required": ["name", "port"], "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9-]{1,15}$"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "targetPort": {"type": ["integer", "string"]}}}}}},
    "grpc": {"type": "object", "properties": {
      "enabled": {"type": "boolean"},
      "port": {"type": "integer", "minimum": 1, "maximum": 65535}}},
    "logFormat": {"enum": ["text", "json"]},
    "metrics": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "podMonitor": {
          "type": "object",
          "properties": {
            "enabled": {"type": "boolean"},
            "labels": {"type": "object"},
            "interval": {"type": "string", "pattern": "^[0-9]+(ms|s|m)$"},
            "scrapeTimeout": {"type": "string", "pattern": "^[0-9]+(ms|s|m)$"}
          }
        }
      }
    },
    "tracing": {
      "type": "object",
      "properties": {
        "otlpEndpoint": {"type": "string", "pattern": "^(https?://[^/ ]+(/[^ ]*)?)?$"}
      }
    },
    "tempo": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "object", "properties": {
          "repository": {"type": "string", "minLength": 1},
          "tag": {"type": "string", "pattern": "^[0-9A-Za-z._-]{1,128}$"},
          "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}}},
        "retention": {"type": "string", "pattern": "^[0-9]+(h|m|s)$"},
        "persistence": {"type": "object", "properties": {
          "enabled": {"type": "boolean"},
          "size": {"type": "string"},
          "storageClassName": {"type": "string"},
          "existingClaim": {"type": "string"}}},
        "emptyDirSize": {"type": "string"},
        "resources": {"type": "object"}
      }
    },
    "grafanaDashboard": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "namespace": {"type": "string"},
        "labels": {"type": "object"},
        "annotations": {"type": "object"}
      }
    },
    "resources": {"type": "object"},
    "tmpSize": {"type": "string"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1},
    "extraContainers": {"type": "array"},
    "extraVolumes": {"type": "array"},
    "extraVolumeMounts": {"type": "array"},
    "podAnnotations": {"type": "object"},
    "podLabels": {"type": "object"},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "serviceAccount": {"type": "object", "properties": {
      "create": {"type": "boolean"},
      "name": {"type": "string"}}}
  }
}
