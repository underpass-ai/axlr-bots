{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "image": {"type": "object", "required": ["repository", "digest"], "properties": {
      "repository": {"type": "string", "minLength": 1},
      "digest": {"type": "string", "pattern": "^(sha256:[0-9a-f]{64})?$"}}},
    "controlPlane": {"type": "object", "properties": {
      "url": {"type": "string", "pattern": "^(https://[^/ ]+)?$"},
      "ca": {"type": "object", "properties": {"existingConfigMap": {"type": "string"}}}}},
    "enrollment": {"type": "object", "properties": {"existingSecret": {"type": "string"}}},
    "model": {"type": "object", "properties": {"enabled": {"type": "boolean"}, "apiKey": {"type": "object", "properties": {
      "existingSecret": {"type": "string"}, "key": {"type": "string", "minLength": 1}}}}},
    "node": {"type": "object", "properties": {
      "idPrefix": {"type": "string", "pattern": "^[a-z0-9._-]{0,40}$"},
      "appLabelKey": {"type": "string", "minLength": 1},
      "dedicated": {"type": "boolean"},
      "labels": {"type": "object", "propertyNames": {"pattern": "^[a-z0-9._-]{1,64}$"},
        "additionalProperties": {"type": "string", "pattern": "^[a-z0-9._-]{1,64}$"}}}},
    "sidecar": {"type": "object", "properties": {
      "name": {"type": "string", "minLength": 1},
      "native": {"type": "boolean"},
      "resources": {"type": "object"},
      "workspaces": {"type": "array", "items": {"type": "object", "required": ["bot", "volume"], "additionalProperties": false, "properties": {
        "bot": {"type": "string", "pattern": "^[a-z0-9._-]{1,64}$"},
        "volume": {"type": "string", "minLength": 1},
        "subPath": {"type": "string"}}}},
      "state": {"type": "object", "properties": {"persistent": {"type": "boolean"}, "size": {"type": "string", "minLength": 1}, "storageClassName": {"type": "string"}}},
      "workspacesSize": {"type": "string", "minLength": 1},
      "tmpSize": {"type": "string", "minLength": 1},
      "env": {"type": "array", "items": {"type": "object", "required": ["name"]}},
      "mcp": {"type": "object", "additionalProperties": false, "properties": {"existingConfigMap": {"type": "string"}, "key": {"type": "string", "minLength": 1}}}}},
    "bus": {"type": "object", "properties": {
      "kind": {"type": "string", "enum": ["direct", "nats"]},
      "nats": {"type": "object", "properties": {
        "url": {"type": "string", "pattern": "^((nats|tls)://[^/ ]+)?$"},
        "ca": {"type": "object", "properties": {"existingConfigMap": {"type": "string"}, "existingSecret": {"type": "string"}}},
        "cidr": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}}}}},
    "networkPolicy": {"type": "object", "properties": {
      "enabled": {"type": "boolean"},
      "controlPlaneCIDR": {"type": "string"},
      "dns": {"type": "object", "properties": {"namespace": {"type": "string", "minLength": 1}, "podLabels": {"type": "object", "minProperties": 1}}},
      "modelProvider": {"type": "object", "properties": {
        "cidrs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "except": {"type": "array", "items": {"type": "string"}},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535}}}}},
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "demo": {"type": "object", "properties": {
      "enabled": {"type": "boolean"},
      "replicas": {"type": "integer", "minimum": 1},
      "name": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?$"},
      "image": {"type": "string", "minLength": 1},
      "bot": {"type": "string", "pattern": "^[a-z0-9._-]{1,64}$"},
      "intervalSeconds": {"type": "integer", "minimum": 1},
      "resources": {"type": "object"},
      "https": {"type": "object", "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string", "pattern": "^([a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+)?$"},
        "image": {"type": "string", "minLength": 1},
        "service": {"type": "object", "properties": {
          "port": {"type": "integer", "minimum": 1, "maximum": 65535},
          "annotations": {"type": "object"},
          "externalTrafficPolicy": {"enum": ["Local", "Cluster"]}}},
        "ingressFrom": {"type": "array", "minItems": 1},
        "serverTLS": {"type": "object", "properties": {"existingSecret": {"type": "string"}}},
        "clientCA": {"type": "object", "properties": {"existingSecret": {"type": "string"}}},
        "certManager": {"type": "object", "properties": {
          "enabled": {"type": "boolean"},
          "serverIssuer": {"type": "object", "properties": {"kind": {"enum": ["Issuer", "ClusterIssuer"]}, "name": {"type": "string"}}},
          "clientCommonName": {"type": "string", "minLength": 1}}}}}}},
    "tests": {"type": "object", "properties": {"enabled": {"type": "boolean"}}}
  }
}
