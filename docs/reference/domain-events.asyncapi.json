{
  "asyncapi": "3.0.0",
  "info": {
    "title": "AXLR Bots domain events",
    "version": "1.0.0",
    "description": "The domain events one team publishes to another (docs/architecture/team-topics.md). A domain event is a fact `<thing>.<what happened>` with the thing's id: it wakes the listening team and carries no instruction. Only the control plane publishes and reads these subjects. Idempotent: `Nats-Msg-Id` is the event's identity (sha256 of team, name and data.id), so the same fact published twice is one message within the stream's window, and the listener's task key repeats it. The wire form is `adapters/bus/domainevent.DTO`; the domain never sees it."
  },
  "defaultContentType": "application/json",
  "servers": {
    "fleet": {
      "host": "nats.example:4222",
      "protocol": "nats",
      "description": "The fleet's NATS with JetStream; mutual TLS as in docs/architecture/bus-port.md. Stream AXLR_DOMAIN, subjects axlr.domain.>, file storage, a republish dropped within 2 minutes by Nats-Msg-Id."
    }
  },
  "channels": {
    "incidenciaNueva": {
      "address": "axlr.domain.{tenant}.{team}.incidencia.nueva",
      "title": "incidencia.nueva",
      "description": "QA triaged a finding: dev takes it from its FIFO queue.",
      "parameters": {
        "tenant": {
          "$ref": "#/components/parameters/tenant"
        },
        "team": {
          "$ref": "#/components/parameters/team"
        }
      },
      "messages": {
        "domainEvent": {
          "$ref": "#/components/messages/domainEvent"
        }
      },
      "x-publisher-team": "qa"
    },
    "incidenciaCompletada": {
      "address": "axlr.domain.{tenant}.{team}.incidencia.completada",
      "title": "incidencia.completada",
      "description": "A fix of the finding was merged: QA checks its repro on the merged commit.",
      "parameters": {
        "tenant": {
          "$ref": "#/components/parameters/tenant"
        },
        "team": {
          "$ref": "#/components/parameters/team"
        }
      },
      "messages": {
        "domainEvent": {
          "$ref": "#/components/messages/domainEvent"
        }
      },
      "x-publisher-team": "dev"
    },
    "incidenciaReabierta": {
      "address": "axlr.domain.{tenant}.{team}.incidencia.reabierta",
      "title": "incidencia.reabierta",
      "description": "QA's repro still fails on the merged commit: dev takes the finding again.",
      "parameters": {
        "tenant": {
          "$ref": "#/components/parameters/tenant"
        },
        "team": {
          "$ref": "#/components/parameters/team"
        }
      },
      "messages": {
        "domainEvent": {
          "$ref": "#/components/messages/domainEvent"
        }
      },
      "x-publisher-team": "qa"
    }
  },
  "operations": {
    "publishIncidenciaNueva": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/incidenciaNueva"
      },
      "summary": "QA publishes, to dev.",
      "messages": [
        {
          "$ref": "#/channels/incidenciaNueva/messages/domainEvent"
        }
      ]
    },
    "receiveIncidenciaNueva": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/incidenciaNueva"
      },
      "summary": "dev listens (subscription team: qa, deliver: team).",
      "messages": [
        {
          "$ref": "#/channels/incidenciaNueva/messages/domainEvent"
        }
      ]
    },
    "publishIncidenciaCompletada": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/incidenciaCompletada"
      },
      "summary": "dev publishes, to QA.",
      "messages": [
        {
          "$ref": "#/channels/incidenciaCompletada/messages/domainEvent"
        }
      ]
    },
    "receiveIncidenciaCompletada": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/incidenciaCompletada"
      },
      "summary": "QA listens (subscription team: dev, deliver: team).",
      "messages": [
        {
          "$ref": "#/channels/incidenciaCompletada/messages/domainEvent"
        }
      ]
    },
    "publishIncidenciaReabierta": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/incidenciaReabierta"
      },
      "summary": "QA publishes, to dev.",
      "messages": [
        {
          "$ref": "#/channels/incidenciaReabierta/messages/domainEvent"
        }
      ]
    },
    "receiveIncidenciaReabierta": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/incidenciaReabierta"
      },
      "summary": "dev listens.",
      "messages": [
        {
          "$ref": "#/channels/incidenciaReabierta/messages/domainEvent"
        }
      ]
    }
  },
  "components": {
    "parameters": {
      "tenant": {
        "description": "The tenant, with '.', '*', '>' and spaces written '_'.",
        "examples": [
          "default"
        ]
      },
      "team": {
        "description": "The emitting team's memory name, written as the tenant is.",
        "examples": [
          "qa",
          "dev"
        ]
      }
    },
    "messages": {
      "domainEvent": {
        "name": "domainEvent",
        "title": "A domain event",
        "contentType": "application/json",
        "headers": {
          "type": "object",
          "required": [
            "Nats-Msg-Id"
          ],
          "properties": {
            "Nats-Msg-Id": {
              "type": "string",
              "description": "The event's identity, the payload's id: JetStream drops a repeat."
            }
          }
        },
        "payload": {
          "$ref": "#/components/schemas/DomainEvent"
        }
      }
    },
    "schemas": {
      "DomainEvent": {
        "type": "object",
        "x-go-type": "domainevent.DTO",
        "additionalProperties": false,
        "required": [
          "specVersion",
          "id",
          "name",
          "tenant",
          "team",
          "from",
          "occurredAt",
          "crossings",
          "audience",
          "data"
        ],
        "properties": {
          "specVersion": {
            "type": "string",
            "const": "1"
          },
          "id": {
            "type": "string",
            "pattern": "^evt-[0-9a-f]{24}$",
            "description": "The identity: evt- and sha256(team NUL name NUL data.id), 12 bytes in hex."
          },
          "name": {
            "type": "string",
            "description": "<thing>.<what happened>, of the info kind; never stop, danger, warn, error or done.",
            "examples": [
              "incidencia.nueva"
            ]
          },
          "tenant": {
            "type": "string"
          },
          "team": {
            "type": "string",
            "description": "The emitting team."
          },
          "from": {
            "type": "string",
            "description": "The bot that published it."
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "traceId": {
            "type": "string"
          },
          "crossings": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "Team boundaries the trace crossed with this one; a fifth is refused (crossing_limit)."
          },
          "audience": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true,
            "description": "The teams the emitter publishes this event to: the teams its emit rule names, never the emitting team. Not part of the identity."
          },
          "data": {
            "$ref": "#/components/schemas/DomainEventData"
          }
        }
      },
      "DomainEventData": {
        "type": "object",
        "x-go-type": "domainevent.DataDTO",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._:@-]{1,128}$",
            "description": "The thing's id: a finding, a fix. A fact that can happen more than once to the same thing carries a round-specific id, so a later round is a new fact and not a repeat: incidencia.completada and incidencia.reabierta use <finding>@<merged sha>."
          },
          "context": {
            "type": "string",
            "maxLength": 256,
            "description": "The KMP key of the context (an about of the emitting team). The listener asks that team for it through the team channel; it never opens the other team's store."
          }
        }
      }
    }
  }
}
