{
  "id": "CHAIR",
  "tenant": "default",
  "name": "CHAIR",
  "owner": "conductor",
  "mission": "SECTION, chair N of TOTAL: a Jev bot. It plays its own line of the score one phrase (8 bars) at a time; Jev, an independent judge, picks each phrase from the candidates the score service offers. No language model: on a cue (info.cue.FAMILY, info.cue.SECTIONKEY or info.cue.all) the node runs the fixed program phrases → Jev → play → listen until the score says done; on stop.* it calls stop once; after each phrase it tells its teammates info.chair.played, and hears theirs.",
  "level": "act-within-policy",
  "allowedTools": [
    "phrases",
    "play",
    "listen",
    "stop"
  ],
  "toolRules": {
    "allow": [],
    "deny": []
  },
  "triggers": [
    {
      "type": "manual"
    }
  ],
  "groups": [
    "orchestra"
  ],
  "events": {
    "emit": [
      {
        "name": "info.chair.*"
      }
    ],
    "intakePerMinute": 60
  },
  "subscriptions": [
    {
      "topic": "info.cue.FAMILY",
      "mode": "message",
      "from": [
        "operator"
      ]
    },
    {
      "topic": "info.cue.SECTIONKEY",
      "mode": "message",
      "from": [
        "operator"
      ]
    },
    {
      "topic": "info.cue.all",
      "mode": "message",
      "from": [
        "operator"
      ]
    },
    {
      "topic": "info.chair.*",
      "mode": "message"
    }
  ],
  "placement": {
    "nodes": [
      "stage-CHAIR"
    ]
  },
  "runtime": {
    "kind": "jev",
    "jev": {
      "server": "score",
      "start": "phrases",
      "act": {
        "tool": "play",
        "choice": "phrase",
        "verdict": "judge",
        "pass": [
          "dynamics"
        ]
      },
      "wait": "listen",
      "stop": "stop",
      "model": "jev-1.13.0",
      "tell": {
        "name": "info.chair.played",
        "fields": [
          "phrase",
          "probability"
        ]
      }
    }
  },
  "model": {
    "model": "",
    "routingPolicy": "cost-optimized",
    "allowRemoteProviders": false
  },
  "budgets": {
    "maxModelCallsPerTask": 64,
    "maxToolCallsPerTask": 128,
    "maxDelegationDepth": 0,
    "taskTimeoutSeconds": 600
  }
}
