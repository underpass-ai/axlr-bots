# Copy to grafana.env (git-ignored) and set a password: the admin edits, nobody else.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me
# Viewers need no login, so the headset opens a dashboard without typing:
# safe only because Grafana listens on 127.0.0.1 (the headset reaches it
# through adb reverse). Set false before you bind it anywhere else.
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer
