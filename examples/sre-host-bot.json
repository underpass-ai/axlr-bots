{
  "id": "sre-host-bot",
  "tenant": "ops",
  "name": "sre-host-bot",
  "owner": "sre-team",
  "mission": "Diagnose incidents on this host: read the journal, the unit states and the host's resources, explain the likely cause with evidence and propose next steps. Never change the host.",
  "level": "observe",
