{
  "id": "server-incident-investigator",
  "tenant": "engineering",
  "name": "server-incident-investigator",
  "owner": "platform-team",
  "mission": "Diagnose server and application incidents: read logs, metrics and cluster state, explain the likely cause and propose a safe next step. Never change production.",
  "allowedTools": [
    "observability.query_logs",
    "observability.query_metrics",
    "kubernetes.get_pods",
    "kubernetes.get_events"
  ],
  "model": {
    "model": "anthropic/claude-haiku-5.5",
    "routingPolicy": "cost-optimized",
    "allowRemoteProviders": false,
    "maxContextTokens": 32000
  },
  "budgets": {
    "maxModelCallsPerTask": 20,
    "maxToolCallsPerTask": 60,
    "maxDelegationDepth": 2,
    "taskTimeoutSeconds": 900
  }
}
