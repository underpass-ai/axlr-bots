<?xml version="1.0"?>
<model>
  <name>port_rover</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author><name>AXLR Bots port fleet example</name></author>
  <description>A car-sized port rover for ArduRover SITL through ArduPilot's gz plugin: Ackermann
    steering on SERVO1, rear-wheel throttle on SERVO3, an IMU, a forward depth sensor in three
    columns (a stand-in for the Intel RealSense D455) and an aft lidar as rangefinders 1 to 4, and
    a chase camera.</description>
</model>
