<?xml version="1.0"?>
<!-- A port quad for ArduCopter 4.7.2 SITL (frame X, copter-X.parm and the
     chart's files/quad.parm) through ArduPilot's gz plugin: the plugin's
     iris_with_ardupilot (model://iris_with_standoffs, its rotors' lift and
     drag, its four motors) with the fleet's sensors. A template: fleet-sim
     puts the vehicle's name for {NAME} and its UDP port for {PORT}.

     Rangefinders, in quad.parm's order (RNGFNDn_TYPE 100 reads the plugin's rng_n):
       1  lidar_down   RNGFND1_ORIENT 25
       2  lidar_fwd    RNGFND2_ORIENT 0
       3  lidar_aft    RNGFND3_ORIENT 4
     Cameras, saved to /frames/{NAME}/:
       nadir  640x480 at 2 Hz, 84 degrees, the image's top is the bow: the photos
       fpv    960x540 at 5 Hz, forward and 10 degrees down: the live view -->
<sdf version="1.9">
  <model name="{NAME}">
    <include>
      <uri>model://iris_with_standoffs</uri>
    </include>

    <!-- The fleet's sensors, fixed to the airframe. X forward, Y left, Z up. -->
    <link name="sensors">
      <inertial>
        <mass>0.01</mass>
        <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- rng_1 down, rng_2 forward, rng_3 aft: 0.2 to 40 m. -->
      <sensor name="lidar_down" type="gpu_lidar">
        <pose>0 0 -0.05 0 1.5708 0</pose>
        <topic>/{NAME}/rng1</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan><horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.0873</min_angle><max_angle>0.0873</max_angle></horizontal></scan>
          <range><min>0.2</min><max>40</max><resolution>0.01</resolution></range>
        </lidar>
        <always_on>1</always_on>
      </sensor>
      <sensor name="lidar_fwd" type="gpu_lidar">
        <pose>0.1 0 0 0 0 0</pose>
        <topic>/{NAME}/rng2</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan><horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.0873</min_angle><max_angle>0.0873</max_angle></horizontal></scan>
          <range><min>0.2</min><max>40</max><resolution>0.01</resolution></range>
        </lidar>
        <always_on>1</always_on>
      </sensor>
      <sensor name="lidar_aft" type="gpu_lidar">
        <pose>-0.1 0 0 0 0 3.14159</pose>
        <topic>/{NAME}/rng3</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan><horizontal><samples>5</samples><resolution>1</resolution><min_angle>-0.0873</min_angle><max_angle>0.0873</max_angle></horizontal></scan>
          <range><min>0.2</min><max>40</max><resolution>0.01</resolution></range>
        </lidar>
        <always_on>1</always_on>
      </sensor>

      <!-- The photo: straight down, the image's top towards the bow. -->
      <sensor name="nadir" type="camera">
        <pose>0 0 -0.05 0 1.5708 0</pose>
        <topic>/{NAME}/nadir/image</topic>
        <update_rate>2</update_rate>
        <camera>
          <!-- 84 degrees: the footprint is 1.8 x the height wide, as vision.frame(). -->
          <horizontal_fov>1.466</horizontal_fov>
          <image><width>640</width><height>480</height></image>
          <clip><near>0.5</near><far>1500</far></clip>
          <save enabled="true"><path>/frames/{NAME}/nadir</path></save>
        </camera>
        <always_on>1</always_on>
      </sensor>
      <!-- The FPV: forward, 10 degrees down. -->
      <sensor name="fpv" type="camera">
        <pose>0.15 0 0 0 0.1745 0</pose>
        <topic>/{NAME}/fpv/image</topic>
        <update_rate>5</update_rate>
        <camera>
          <horizontal_fov>1.5</horizontal_fov>
          <image><width>960</width><height>540</height></image>
          <clip><near>0.5</near><far>3000</far></clip>
          <save enabled="true"><path>/frames/{NAME}/fpv</path></save>
        </camera>
        <always_on>1</always_on>
      </sensor>
    </link>
    <joint name="sensors_joint" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>sensors</child>
    </joint>

    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
    </plugin>

    <!-- Each rotor's two blades: lift and drag. -->
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_0</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_0</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_1</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_1</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_2</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_2</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>0.084 0 0</cp>
      <forward>0 -1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_3</link_name>
    </plugin>
    <plugin filename="gz-sim-lift-drag-system" name="gz::sim::systems::LiftDrag">
      <a0>0.3</a0>
      <alpha_stall>1.4</alpha_stall>
      <cla>4.2500</cla>
      <cda>0.10</cda>
      <cma>0.0</cma>
      <cla_stall>-0.025</cla_stall>
      <cda_stall>0.0</cda_stall>
      <cma_stall>0.0</cma_stall>
      <area>0.002</area>
      <air_density>1.2041</air_density>
      <cp>-0.084 0 0</cp>
      <forward>0 1 0</forward>
      <upward>0 0 1</upward>
      <link_name>iris_with_standoffs::rotor_3</link_name>
    </plugin>

    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_0_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_1_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_2_joint</joint_name>
    </plugin>
    <plugin filename="gz-sim-apply-joint-force-system" name="gz::sim::systems::ApplyJointForce">
      <joint_name>iris_with_standoffs::rotor_3_joint</joint_name>
    </plugin>

    <plugin filename="ArduPilotPlugin" name="ArduPilotPlugin">
      <!-- Any address: the vehicle's SITL is in its own pod. The plugin answers
           wherever the last packet came from. -->
      <fdm_addr>0.0.0.0</fdm_addr>
      <fdm_port_in>{PORT}</fdm_port_in>
      <!-- The plugin no longer waits for a packet (lock_step off): a step
           without one is not a lost link; a second of them is. -->
      <connectionTimeoutMaxCount>1000</connectionTimeoutMaxCount>
      <!-- Off: a stopped SITL must not stop the world the others fly in. -->
      <lock_step>0</lock_step>
      <no_time_sync>1</no_time_sync>
      <have_32_channels>0</have_32_channels>
      <modelXYZToAirplaneXForwardZDown degrees="true">0 0 0 180 0 0</modelXYZToAirplaneXForwardZDown>
      <gazeboXYZToNED degrees="true">0 0 0 180 0 90</gazeboXYZToNED>
      <imuName>iris_with_standoffs::imu_link::imu_sensor</imuName>
      <!-- SERVO1 to SERVO4: the motors, 838 rad/s at full throttle. -->
      <control channel="0">
        <jointName>iris_with_standoffs::rotor_0_joint</jointName>
        <useForce>1</useForce>
        <multiplier>838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <control channel="1">
        <jointName>iris_with_standoffs::rotor_1_joint</jointName>
        <useForce>1</useForce>
        <multiplier>838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <control channel="2">
        <jointName>iris_with_standoffs::rotor_2_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <control channel="3">
        <jointName>iris_with_standoffs::rotor_3_joint</jointName>
        <useForce>1</useForce>
        <multiplier>-838</multiplier>
        <offset>0</offset>
        <servo_min>1100</servo_min>
        <servo_max>1900</servo_max>
        <type>VELOCITY</type>
        <p_gain>0.20</p_gain>
        <i_gain>0</i_gain>
        <d_gain>0</d_gain>
        <i_max>0</i_max>
        <i_min>0</i_min>
        <cmd_max>2.5</cmd_max>
        <cmd_min>-2.5</cmd_min>
        <controlVelocitySlowdownSim>1</controlVelocitySlowdownSim>
      </control>
      <!-- rng_1 to rng_3: the nearest return of each lidar, in metres. -->
      <sensor><type>lidar</type><index>1</index><topic>/{NAME}/rng1</topic></sensor>
      <sensor><type>lidar</type><index>2</index><topic>/{NAME}/rng2</topic></sensor>
      <sensor><type>lidar</type><index>3</index><topic>/{NAME}/rng3</topic></sensor>
    </plugin>
  </model>
</sdf>
