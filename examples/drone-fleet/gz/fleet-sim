#!/usr/bin/env python3
"""Run the port fleet's one gz sim world and put the fleet's vehicles in it.

    fleet-sim --vehicles vehicles.json [--spawn-only]

vehicles.json lists the vehicles that fly or drive in gz, each on its pad and
with its own UDP port for ArduPilot's JSON SITL:

    [{"name": "quad-0", "kind": "quad", "lat": 51.94550, "lon": 3.99735, "heading": 0, "port": 9002},
     {"name": "rover-0", "kind": "rover", "lat": 51.94700, "lon": 4.02705, "heading": 0, "port": 9032}]

In order: starts gz sim (server, headless rendering) on the Maasvlakte 2
world unless one already serves it; waits for its create service; creates
each vehicle from its kind's template (models/port_<kind>/model.sdf.tmpl,
{NAME} and {PORT} filled in) on its pad; listens to each camera (gz renders a
camera, and saves its pictures, only while something listens to it). Then it
writes the real time factor to the log every 10 s while gz runs, and exits
with gz. With --spawn-only it stops after the cameras and leaves gz running.

The pad's latitude and longitude become metres east and north of the world's
origin (port3d/area.py's to_local); the quays are at 5 m; heading is a
compass heading, gz's yaw is from the east, anticlockwise.
"""

import argparse
import json
import math
import os
import re
import subprocess
import sys
import time

WORLD = "maasvlakte2"
WORLD_SDF = "/gz/worlds/maasvlakte2.sdf"
MODELS = os.environ.get("FLEET_GZ_MODELS", "/gz/models")

# port3d/area.py
ORIGIN = (51.9440, 3.9990)
GROUND_M = 5.0
EARTH_RADIUS_M = 6378137.0

# The model's origin above the quay: the quad's legs, the rover's wheel centres.
Z_OFFSET = {"quad": 0.2, "rover": 0.4}
CAMERAS = {"quad": ("nadir", "fpv"), "rover": ("fpv",)}


def to_local(lat, lon):
    """(east, north) in metres of (lat, lon) from ORIGIN, as area.to_local."""
    lat0, lon0 = ORIGIN
    north = math.radians(lat - lat0) * EARTH_RADIUS_M
    east = math.radians(lon - lon0) * EARTH_RADIUS_M * math.cos(math.radians(lat0))
    return east, north


def pad_pose(vehicle):
    """(x, y, z, yaw) in the world of a vehicle on its pad."""
    east, north = to_local(vehicle["lat"], vehicle["lon"])
    yaw = math.radians(90.0 - float(vehicle.get("heading", 0)))
    return east, north, GROUND_M + Z_OFFSET[vehicle["kind"]], yaw


def model_sdf(vehicle, models=MODELS):
    """The vehicle's SDF: its kind's template with its name and port."""
    with open(os.path.join(models, f"port_{vehicle['kind']}", "model.sdf.tmpl")) as f:
        tmpl = f.read()
    return tmpl.replace("{NAME}", vehicle["name"]).replace("{PORT}", str(int(vehicle["port"])))


def create_request(vehicle, sdf):
    """The text of a gz.msgs.EntityFactory for the vehicle on its pad."""
    x, y, z, yaw = pad_pose(vehicle)
    return (f"sdf: {json.dumps(sdf)} name: \"{vehicle['name']}\" allow_renaming: false "
            f"pose: {{position: {{x: {x:.3f}, y: {y:.3f}, z: {z:.3f}}} "
            f"orientation: {{w: {math.cos(yaw / 2):.6f}, x: 0, y: 0, z: {math.sin(yaw / 2):.6f}}}}}")


def camera_topics(vehicle):
    return [f"/{vehicle['name']}/{cam}/image" for cam in CAMERAS[vehicle["kind"]]]


def load_vehicles(path):
    with open(path) as f:
        vehicles = json.load(f)
    names = set()
    for v in vehicles:
        if v.get("kind") not in Z_OFFSET:
            raise ValueError(f"{v.get('name')}: kind must be quad or rover")
        if not re.fullmatch(r"[a-z0-9-]+", v.get("name", "")):
            raise ValueError(f"{v.get('name')!r}: a name is [a-z0-9-]")
        if v["name"] in names:
            raise ValueError(f"{v['name']}: listed twice")
        names.add(v["name"])
    return vehicles


def parse_rtf(text):
    """The real time factor of a printed gz.msgs.WorldStatistics, or None."""
    m = re.search(r"real_time_factor:\s*([0-9.eE+-]+)", text)
    return float(m.group(1)) if m else None


def say(text):
    print(f"fleet-sim: {text}", flush=True)


def gz_service(service, reqtype, req, timeout_ms=10000):
    return subprocess.run(["gz", "service", "-s", service, "--reqtype", reqtype, "--reptype", "gz.msgs.Boolean",
                           "--timeout", str(timeout_ms), "--req", req], capture_output=True, text=True, check=False)


def has_create():
    out = subprocess.run(["gz", "service", "-l"], capture_output=True, text=True, check=False).stdout
    return f"/world/{WORLD}/create" in out.split()


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--vehicles", required=True)
    ap.add_argument("--spawn-only", action="store_true", help="leave gz running and exit once the vehicles are in")
    args = ap.parse_args()
    vehicles = load_vehicles(args.vehicles)

    gz = None
    if not has_create():
        # Its own session: with --spawn-only gz outlives this process.
        gz = subprocess.Popen(["gz", "sim", "-s", "-r", "--headless-rendering", "-v", "3", WORLD_SDF],
                              start_new_session=args.spawn_only)
        say(f"gz sim started (pid {gz.pid})")
    deadline = time.monotonic() + 180
    while not has_create():
        if gz is not None and gz.poll() is not None:
            sys.exit(f"fleet-sim: gz sim exited with {gz.returncode}")
        if time.monotonic() > deadline:
            sys.exit("fleet-sim: gz sim did not start")
        time.sleep(1)

    for v in vehicles:
        out = gz_service(f"/world/{WORLD}/create", "gz.msgs.EntityFactory", create_request(v, model_sdf(v)))
        if "true" not in out.stdout:
            sys.exit(f"fleet-sim: gz create {v['name']}: {out.stdout.strip()} {out.stderr.strip()}")
        x, y, z, yaw = pad_pose(v)
        say(f"{v['name']} ({v['kind']}) at {x:.1f} E {y:.1f} N {z:.1f} up, yaw {math.degrees(yaw):.0f}, udp {v['port']}")
    for v in vehicles:
        for topic in camera_topics(v):
            subprocess.Popen(["gz", "topic", "-e", "-t", topic], stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, start_new_session=args.spawn_only)
    say(f"{len(vehicles)} vehicles in the world, cameras on")
    if args.spawn_only:
        return

    while gz is None or gz.poll() is None:
        out = subprocess.run(["gz", "topic", "-e", "-t", f"/world/{WORLD}/stats", "-n", "1"],
                             capture_output=True, text=True, timeout=30, check=False).stdout
        rtf = parse_rtf(out)
        if rtf is not None:
            say(f"real time factor {rtf:.2f}")
        time.sleep(10)
    sys.exit(f"fleet-sim: gz sim exited with {gz.returncode}")


if __name__ == "__main__":
    main()
