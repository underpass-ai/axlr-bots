{
  "openapi": "3.1.0",
  "info": {
    "title": "ais",
    "version": "1",
    "description": "The port fleet's AIS receiver: the ships aisstream.io reports around the port, live. One connection to aisstream.io per key; every client (the fleet base, the 3D view, a Gazebo spawner, a bot's tool) reads this API instead. What AIS sends for 'not available' (102.3 kn, 360 degrees, heading 511, status 15, type 0) is null. A ship not heard from for 15 minutes is dropped."
  },
  "paths": {
    "/v1/ships": {
      "get": {
        "summary": "The ships heard now",
        "parameters": [
          {"name": "bbox", "in": "query", "description": "lat1,lon1,lat2,lon2: only ships inside", "schema": {"type": "string"}},
          {"name": "type", "in": "query", "description": "a type name (cargo, tanker, tug…) or an AIS type code", "schema": {"type": "string"}},
          {"name": "name", "in": "query", "description": "part of the ship's name, any case", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "the ships and the receiver's state", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ShipList"}}}},
          "400": {"description": "a malformed filter", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/v1/ships/{mmsi}": {
      "get": {
        "summary": "One ship",
        "parameters": [{"name": "mmsi", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[0-9]+$"}}],
        "responses": {
          "200": {"description": "the ship", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Ship"}}}},
          "404": {"description": "not heard in the last 15 minutes", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/v1/ships/{mmsi}/track": {
      "get": {
        "summary": "A ship's recent positions, oldest first (at most 240)",
        "parameters": [
          {"name": "mmsi", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[0-9]+$"}},
          {"name": "since", "in": "query", "description": "RFC 3339 (2026-10-26T18:00:00Z) or epoch seconds", "schema": {"type": "string"}}
        ],
        "responses": {
          "200": {"description": "the positions", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Track"}}}},
          "400": {"description": "a malformed since", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}},
          "404": {"description": "not heard in the last 15 minutes", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Error"}}}}
        }
      }
    },
    "/v1/stream": {
      "get": {
        "summary": "Server-sent events: `position` (a position report) and `static` (name, type, size), each with the ship as it is now; a comment every 15 s keeps the connection open",
        "responses": {"200": {"description": "the event stream; each event's data is a Ship", "content": {"text/event-stream": {"schema": {"type": "string"}}}}}
      }
    },
    "/healthz": {
      "get": {"summary": "Liveness", "responses": {"200": {"description": "ok", "content": {"text/plain": {"schema": {"type": "string"}}}}}}
    }
  },
  "components": {
    "schemas": {
      "Ship": {
        "type": "object",
        "required": ["mmsi", "name", "callsign", "imo", "type", "type_name", "length_m", "beam_m", "dim", "draught_m", "destination", "lat", "lon", "sog", "cog", "heading", "nav_status", "last_seen"],
        "properties": {
          "mmsi": {"type": "string"},
          "name": {"type": ["string", "null"]},
          "callsign": {"type": ["string", "null"]},
          "imo": {"type": ["integer", "null"]},
          "type": {"type": ["integer", "null"], "description": "AIS ship type code, 1 to 99"},
          "type_name": {"type": ["string", "null"], "description": "cargo, tanker, passenger, tug…"},
          "length_m": {"type": ["number", "null"], "description": "A + B"},
          "beam_m": {"type": ["number", "null"], "description": "C + D"},
          "dim": {"description": "the antenna's distance to the bow (a), stern (b), port (c) and starboard (d), metres", "oneOf": [{"type": "null"}, {"$ref": "#/components/schemas/Dimensions"}]},
          "draught_m": {"type": ["number", "null"]},
          "destination": {"type": ["string", "null"]},
          "lat": {"type": "number"},
          "lon": {"type": "number"},
          "sog": {"type": ["number", "null"], "description": "speed over ground, knots"},
          "cog": {"type": ["number", "null"], "description": "course over ground, degrees"},
          "heading": {"type": ["number", "null"], "description": "true heading, degrees"},
          "nav_status": {"type": ["integer", "null"], "description": "AIS navigational status, 0 to 14"},
          "last_seen": {"type": ["string", "null"], "format": "date-time"}
        }
      },
      "Dimensions": {
        "type": "object",
        "required": ["a", "b", "c", "d"],
        "properties": {"a": {"type": "integer"}, "b": {"type": "integer"}, "c": {"type": "integer"}, "d": {"type": "integer"}}
      },
      "Summary": {
        "type": "object",
        "required": ["status", "ships", "updated", "error"],
        "properties": {
          "status": {"type": "string", "enum": ["off", "connecting", "live", "error"]},
          "ships": {"type": "integer"},
          "updated": {"type": "number", "description": "epoch seconds of the last message"},
          "error": {"type": "string"}
        }
      },
      "ShipList": {
        "type": "object",
        "required": ["ships", "summary"],
        "properties": {"ships": {"type": "array", "items": {"$ref": "#/components/schemas/Ship"}}, "summary": {"$ref": "#/components/schemas/Summary"}}
      },
      "TrackPoint": {
        "type": "object",
        "required": ["t", "lat", "lon", "sog", "cog"],
        "properties": {"t": {"type": "string", "format": "date-time"}, "lat": {"type": "number"}, "lon": {"type": "number"}, "sog": {"type": ["number", "null"]}, "cog": {"type": ["number", "null"]}}
      },
      "Track": {
        "type": "object",
        "required": ["mmsi", "points"],
        "properties": {"mmsi": {"type": "string"}, "points": {"type": "array", "items": {"$ref": "#/components/schemas/TrackPoint"}}}
      },
      "Error": {"type": "object", "required": ["error"], "properties": {"error": {"type": "string"}}}
    }
  }
}
