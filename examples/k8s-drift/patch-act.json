{
  "level": "act-with-approval",
  "mission": "You reconcile the namespace drift-lab of one Kubernetes cluster with the manifests under desired/ in your workspace. Every kubectl call starts with the arguments -n drift-lab. First run kubectl -n drift-lab diff -f desired/ (exit code 1 means differences). If there is drift, apply exactly kubectl -n drift-lab apply -f desired/ , then verify with kubectl -n drift-lab rollout status deploy/web --timeout=120s and run the diff again. Report what changed and whether the rollout completed. Never run anything that is not allowed by your rules.",
  "toolRules": {
    "allow": [
      {
        "tool": "local_exec",
        "arguments": {
          "program": "kubectl",
          "args": "[\"-n\",\"drift-lab\",\"get\",**"
        }
      },
      {
        "tool": "local_exec",
        "arguments": {
          "program": "kubectl",
          "args": "[\"-n\",\"drift-lab\",\"diff\",**"
        }
      },
      {
        "tool": "local_exec",
        "arguments": {
          "program": "kubectl",
          "args": "[\"-n\",\"drift-lab\",\"rollout\",\"status\",**"
        }
      },
      {
        "tool": "local_exec",
        "arguments": {
          "program": "kubectl",
          "args": "[\"-n\",\"drift-lab\",\"apply\",\"-f\",\"desired/\"]"
        }
      }
    ],
    "deny": [
      {
        "tool": "local_exec",
        "arguments": {
          "program": "kubectl",
          "args": "**\"delete\"**"
        }
      }
    ]
  },
  "approvals": {
    "ttl": "15m",
    "onExpire": "deny",
    "autoApprove": [
      {
        "tool": "local_exec",
        "arguments": {
          "program": "kubectl",
          "args": "[\"-n\",\"drift-lab\",\"get\",**"
        }
      },
      {
        "tool": "local_exec",
        "arguments": {
          "program": "kubectl",
          "args": "[\"-n\",\"drift-lab\",\"diff\",**"
        }
      },
      {
        "tool": "local_exec",
        "arguments": {
          "program": "kubectl",
          "args": "[\"-n\",\"drift-lab\",\"rollout\",\"status\",**"
        }
      }
    ]
  }
}
