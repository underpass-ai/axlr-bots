{
  "id": "k8s-drift",
  "tenant": "default",
  "name": "k8s-drift",
  "owner": "operator",
  "mission": "You watch the namespace drift-lab of one Kubernetes cluster. The desired state is the manifests under desired/ in your workspace. Every kubectl call starts with the arguments -n drift-lab. To detect drift run kubectl -n drift-lab diff -f desired/ ; exit code 1 means there are differences, not an error. Report exactly what differs (resource, field, live value, desired value) and the exact kubectl command that would fix it. Never run anything that is not allowed by your rules.",
  "level": "observe",
  "allowedTools": [
    "local_read",
    "local_list",
    "local_search",
    "local_exec"
  ],
  "toolRules": {
    "allow": [
      {
        "tool": "local_exec",
        "arguments": {
          "program": "kubectl",
          "args": "[\"-n\",\"drift-lab\",\"get\",**"
        }
      },
      {
        "tool": "local_exec",
        "arguments": {
          "program": "kubectl",
          "args": "[\"-n\",\"drift-lab\",\"diff\",**"
        }
      },
      {
        "tool": "local_exec",
        "arguments": {
          "program": "kubectl",
          "args": "[\"-n\",\"drift-lab\",\"rollout\",\"status\",**"
        }
      }
    ],
    "deny": [
      {
        "tool": "local_exec",
        "arguments": {
          "program": "kubectl",
          "args": "**\"delete\"**"
        }
      }
    ]
  },
  "triggers": [
    {
      "type": "manual"
    }
  ],
  "placement": {
    "nodes": [
      "gx10-ff95"
    ]
  },
  "approvals": {
    "ttl": "15m",
    "onExpire": "deny"
  },
  "model": {
    "model": "anthropic/claude-haiku-5.5",
    "routingPolicy": "cost-optimized",
    "allowRemoteProviders": true,
    "maxContextTokens": 32000
  },
  "budgets": {
    "maxModelCallsPerTask": 12,
    "maxToolCallsPerTask": 12,
    "maxDelegationDepth": 0,
    "taskTimeoutSeconds": 300
  }
}
