#!/bin/sh
# A stand-in for `axlr-tui --exec --json` that needs no model provider:
# it prints the JSON lines of a finished turn, ending with the execution
# result object of the runtime contract, and exits 0. Point the control
# plane at it with --axlr-bin (or AXLR_TUI) to run the Phase 0
# demo offline.
prompt=""
for a in "$@"; do
  if [ "$a" = --help ]; then
    # Like the real binary: the flags on stderr. No -policy: the control
    # plane then records the policy without passing it.
    echo '  -exec string' >&2
    exit 0
  fi
done
while [ $# -gt 0 ]; do
  case "$1" in
    --exec|-exec) prompt="$2"; shift ;;
  esac
  shift
done
printf '%s\n' '{"type":"session","session":"sess-fake-1"}'
printf '%s\n' '{"type":"tool.requested","tool":"local_list","call_id":"c1","decision":"auto_approve"}'
printf '%s\n' '{"type":"tool.completed","tool":"local_list","call_id":"c1","decision":"auto_approve"}'
printf '%s\n' '{"type":"text","text":"Fake answer to: "}'
printf '{"type":"text","text":%s}\n' "\"$(printf '%s' "$prompt" | sed 's/\\/\\\\/g; s/"/\\"/g')\""
printf '%s\n' '{"type":"completed","session":"sess-fake-1","status":"idle"}'
printf '{"type":"result","session":"sess-fake-1","result":{"schema":"axlr.execution-result/v1","status":"completed","session_id":"sess-fake-1","sessions":["sess-fake-1"],"answer":"Fake answer to: %s","tool_calls":[{"call_id":"c1","tool":"local_list","decision":"auto_approve","status":"completed"}],"usage":{"requests":1,"prompt_tokens":120,"cached_tokens":0,"cache_write_tokens":0,"completion_tokens":12,"reasoning_tokens":0,"cost_usd":0.0001,"cost_requests":1,"unmetered_requests":0},"artifacts":[]}}\n' "$(printf '%s' "$prompt" | sed 's/\\/\\\\/g; s/"/\\"/g')"
exit 0
